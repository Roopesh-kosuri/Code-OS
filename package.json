{
  "name": "code-os",
  "version": "3.0.0",
  "description": "CODE OS v3.0.0 - Next-generation agentic AI operating system for developers",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Roopesh Kosuri",
  "license": "SEE LICENSE IN License.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roopesh-kosuri/code-os.git"
  },
  "bugs": {
    "url": "https://github.com/Roopesh-kosuri/code-os/issues"
  },
  "homepage": "https://github.com/Roopesh-kosuri/code-os#readme",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:backend": "node scripts/dev-backend.js",
    "dev:electron": "wait-on http://127.0.0.1:5176 && npm run build:electron && electron .",
    "download:runtimes": "node scripts/download-runtimes.js",
    "build:backend-exe": "node scripts/build-backend.js",
    "build:vite": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:renderer": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build": "npm run typecheck && npm run build:vite && npm run build:electron && npm run build:backend-exe && npm run download:runtimes",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -mwl",
    "package": "npm run build && electron-builder",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/forms": "^0.5.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.codeos.app",
    "productName": "CODE OS",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/node-runtime",
        "to": "node-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend-dist/backend-server.exe",
        "to": "backend-server.exe"
      },
      {
        "from": "backend-dist/backend-server",
        "to": "backend-server"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CODE OS",
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "dir"
      ],
      "category": "Development",
      "maintainer": "Roopesh Kosuri <roopesh@codeos.ai>"
    }
  }
}