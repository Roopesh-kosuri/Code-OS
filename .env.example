# ==============================================================================
# CODE OS — Environment Configuration Example
# Copy this file to .env and configure values as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
# Host interface for backend API server (default: 127.0.0.1)
HOST=127.0.0.1

# Port for backend FastAPI server (default: 8000)
PORT=8000

# Port for Vite frontend dev server (default: 5173 / 5176)
VITE_PORT=5173

# Optional custom session token (generated automatically if omitted)
# CODE_OS_SESSION_TOKEN=your-random-32-byte-hex-token-here

# ------------------------------------------------------------------------------
# AI Provider API Keys (Optional — can also be set via UI Settings)
# ------------------------------------------------------------------------------
# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Mistral AI API Key (https://console.mistral.ai/)
MISTRAL_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# NVIDIA NIM API Key (https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=

# Ollama Base URL (Local inference, default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# Sandboxing & Execution Limits
# ------------------------------------------------------------------------------
# Maximum execution runtime in seconds for runner processes (default: 60)
MAX_EXECUTION_TIMEOUT_SECONDS=60

# Maximum memory limit in megabytes per executed process (default: 512)
MAX_MEMORY_MB=512

# Enable strict containerized sandbox isolation (default: false)
SANDBOX_ENFORCE_CONTAINER=false

# ------------------------------------------------------------------------------
# Logging & Monitoring
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Optional Sentry DSN for remote error monitoring and telemetry
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
